Options -Indexes +FollowSymLinks
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent duplicate public_html paths
    RewriteCond %{THE_REQUEST} /public_html/public_html/ [NC]
    RewriteRule ^public_html/(.*)$ $1 [R=301,L]

    # If accessed directly at domain root, route to public_html only if not already inside public_html
    RewriteCond %{REQUEST_URI} !^/public_html/ [NC]
    RewriteCond %{DOCUMENT_ROOT}/public_html -d
    RewriteRule ^(.*)$ public_html/$1 [L]
</IfModule>
