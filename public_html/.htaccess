Options -Indexes +FollowSymLinks
RewriteEngine On

# 1. Strip index.php from URL (e.g. /public_html/index.php -> /public_html/)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index\.php [NC]
RewriteRule ^ %1/ [R=301,L]

# 2. Redirect .php to clean URL (e.g. /track_order.php -> /track_order)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Route clean URLs to .php files internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# 4. Custom clean alias
RewriteRule ^track-order/?$ track_order.php [L]
RewriteRule ^sitemap\.xml/?$ sitemap.php [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
