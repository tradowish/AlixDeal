Options -Indexes +FollowSymLinks
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Never rewrite install, admin, or api directories
    RewriteRule ^(install|admin|api) - [L]

    # 2. Clean aliases for customer storefront
    RewriteRule ^track-order/?$ track_order.php [L]
    RewriteRule ^sitemap\.xml/?$ sitemap.php [L]

    # 3. Route clean URLs to .php for storefront only (if file exists)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
